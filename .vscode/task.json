{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build all apps",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.script/build-rtos",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build one app",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.script/build-rtos ${input:appName}",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Deploy app to board",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/.script/deploy-rtos", "${input:appName}"],
      "options": { "env": { "BOARD_IP": "${input:boardIp}" } },
      "problemMatcher": []
    },
    {
      "label": "Build host",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.script/build-rtos --host",
      "problemMatcher": ["$gcc"]
    }
  ],
  "inputs": [
    {
      "id": "appName",
      "type": "pickString",
      "description": "板端可执行目标",
      "options": ["dart_vision", "launcher"],
      "default": "dart_vision"
    },
    {
      "id": "boardIp",
      "type": "promptString",
      "description": "板子 IP 地址",
      "default": "192.168.1.100"
    }
  ]
}
